\begin{tikzpicture}[
    line/.style={
        black,
        line width=1pt
    },
    blue/.style={
        draw=blue!75!black,
        fill=blue!30,
        fill opacity=0.7,
        draw opacity=1,
        line width=1pt
    },
    red/.style={
        draw=red!75!black,
        fill=red!30,
        fill opacity=0.7,
        draw opacity=1,
        line width=1pt
    },
    bluearrow/.style={
        ->,
        blue!75!black,
        line width=0.5pt
    },
    redarrow/.style={
        ->,
        red!75!black,
        line width=0.5pt
    },
    mixarrow/.style={
        ->,
        blue!75!red!75,
        line width=0.5pt
    },
    axis/.style={
        -Stealth,
        black,
        line width=1pt
    }
]

% M_1 and M_2
\draw[line] (-5,1.5) -- (-2.05,1.5) node[midway,above] {\(M_1\)};

\draw[line] (2.05,1.5) -- (5,1.5) node[midway,above] {\(M_2\)};

\draw[axis] (-5,-1.5) -- (-2.05,-1.5) node[midway,below] {\(\R\)};
\draw[axis] (2.05,-1.5) -- (5,-1.5) node[midway,below] {\(\R\)};

% x -> x^{1/3}
\draw[mixarrow]
    (-1.65,1.5) -- (1.65,1.5)
    node[midway,above] {\(\psi\)};

% x -> x
\draw[bluearrow]
    (-1.85,1.25) -- (-1.85,-1.25)
    node[midway,left] {\(\varphi_1\)};

% x -> x^3
\draw[redarrow]
    (1.85,1.25) -- (1.85,-1.25)
    node[midway,right] {\(\varphi_2\)};

% id
\draw[mixarrow]
    (-1.65,-1.5) -- (1.65,-1.5)
    node[midway,above] {\(\varphi_2\circ\psi\circ\varphi_1^{-1}\)}
    node[midway,below] {\(\id\)};

\node at (-1.85, 1.5) {\(x\)};
\node at ( 2.1, 1.6) {\(x^{1/3}\)};
\node[blue!75!black] at (-1.85,-1.5) {\(x\)};
\node[red!75!black] at ( 1.85,-1.5) {\(x\)};

\end{tikzpicture}