\begin{tikzpicture}[
    space/.style={
        draw=blue!75!black,
        fill=blue!20,
        fill opacity=0.7,
        draw opacity=1,
        line width=1pt
    },
    slice/.style={
        red!75!black,
        line width=1.4pt
    },
    maparrow/.style={
        ->,
        line width=0.5pt
    },
    bluearrow/.style={
        ->,
        blue!75!black,
        line width=0.5pt
    },
    bluepoint/.style={
        fill=blue!75!black,
        draw=blue!75!black
    },
    redpoint/.style={
        fill=red!75!black,
        draw=red!75!black
    },
]

% ------------------------------------------------
% U_1 neighborhood of p
% ------------------------------------------------
\draw[space]
    plot[smooth cycle, tension=0.8] coordinates {
        (-3.85,1.25)
        (-3.45,2.00)
        (-2.70,2.55)
        (-1.82,2.72)
        (-1.08,2.42)
        (-0.82,1.72)
        (-1.18,1.08)
        (-1.98,0.82)
        (-2.82,0.90)
        (-3.50,1.02)
    };

\node[blue!75!black] at (-3.18,2.72) {\(U_1\)};

% S slice in U_1
\draw[slice]
    (-3.2,0.95)
    .. controls (-2.85,1.35) and (-2.20,1.80) ..
    (-0.88,2.10);

\node[red!80!black] at (-4.6,0.8) {\(S=f^{-1}(q)\)};

% bluepoint p
\fill[bluepoint] (-2.30,1.6) circle (1.6pt);
\node[blue!75!black, above left] at (-2.30,1.6) {\(p\)};

% ------------------------------------------------
% X_1
% ------------------------------------------------
\draw[space]
    plot[smooth cycle, tension=0.8] coordinates {
        (1.25,1.32)
        (1.65,2.02)
        (2.45,2.48)
        (3.42,2.68)
        (4.05,2.35)
        (4.12,1.62)
        (3.62,1.03)
        (2.72,0.82)
        (1.82,0.92)
    };

\node[blue!75!black] at (3.70,2.92) {\(X_1\)};

\fill[redpoint] (2.62,1.70) circle (1.6pt);
\node[red!75!black, right] at (2.62,1.70) {\(q\)};

% f arrow
\draw[maparrow]
    (-0.45,1.72) -- (1.05,1.72)
    node[midway,above] {\(f\)};

% V_1
\draw[space]
    plot[smooth cycle, tension=0.8] coordinates {
        (-3.95,-2.55)
        (-3.65,-1.85)
        (-2.88,-1.45)
        (-1.85,-1.32)
        (-1.05,-1.65)
        (-0.78,-2.32)
        (-1.18,-2.95)
        (-1.95,-3.30)
        (-2.75,-3.22)
        (-3.48,-3.02)
    };

\node[blue!75!black] at (-2.35,-3.72) {\(V_1\)};

% slice in V_1
\draw[slice]
    (-3.35,-3.08)
    .. controls (-3.10,-2.55) and (-2.28,-2.00) ..
    (-1.02,-1.72);

% origin in V_1
\filldraw[blue!75!black, line width=1pt] (-2.32,-2.18) circle (1.6pt);
\node[blue!75!black, below right] at (-2.32,-2.18) {\(0\)};

% phi_1 arrow
\draw[bluearrow]
    (-2.35,0.65) -- (-2.35,-1.10)
    node[midway,right] {\(\varphi_1\)};

% ------------------------------------------------
% Y_1
% ------------------------------------------------
\draw[space]
    plot[smooth cycle, tension=0.8] coordinates {
        (1.62,-2.42)
        (1.88,-1.78)
        (2.55,-1.42)
        (3.42,-1.38)
        (4.08,-1.72)
        (4.22,-2.35)
        (3.82,-2.92)
        (3.05,-3.25)
        (2.20,-3.10)
    };

\node[blue!75!black] at (3.08,-3.70) {\(Y_1\)};

% origin in Y_1
\fill[redpoint] (2.90,-2.42) circle (1.6pt);
\node[red!75!black, below right] at (2.90,-2.42) {\(0\)};

% psi_1 arrow
\draw[bluearrow]
    (2.90,0.60) -- (2.90,-1.05)
    node[midway,right] {\(\psi_1\)};

% pi arrow
\draw[maparrow]
    (-0.45,-2.42) -- (1.35,-2.42)
    node[midway,above] {\(\psi_1\circ f\circ\varphi_1^{-1}\)}
    node[midway,below] {\(\pi\)};

\end{tikzpicture}