\begin{tikzpicture}[
    axis/.style={
        -Stealth,
        black,
        line width=1pt
    },
    bluegraph/.style={
        blue!75!black,
        line width=1pt,
        smooth
    },
    redgraph/.style={
        red!75!black,
        line width=1pt,
        smooth
    },
    blackgraph/.style={
        draw=gray!30,
        line width=1pt,
        smooth
    },
    markline/.style={
        blue!75!black,
        line width=1pt
    }
]

% Parameters
\def\eps{2.2}

% Axes
\draw[axis] (-3.2,0) -- (4.0,0) node[right] {\(x\)};
\draw[axis] (0,-1.1) -- (0,2.2) node[above] {\(y\)};

% f_2(x) = 0 for x <= 0
\draw[redgraph] (-3.0,0) -- (0,0);

% Smooth transition from 0 to 1 on (0, epsilon)
% Drawn as a stylized bump cutoff curve
\draw[blackgraph]
    (0,0)
    .. controls (0.35,0.05) and (0.65,0.25) ..
    (0.85,0.48)
    .. controls (1.15,0.85) and (1.45,1.15) ..
    (1.85,1.33)
    .. controls (2.00,1.40) and (2.12,1.43) ..
    (\eps,1.43);

\draw[bluegraph] (\eps,1.43) -- (3.6,1.43);

\draw[markline] (\eps,0.08) -- (\eps,-0.08);
\node[markline, below] at (\eps,-0.08) {\(\varepsilon\)};

\draw[markline] (0.08,1.43) -- (-0.08,1.43);
\node[markline, left] at (-0.08,1.43) {\(1\)};

\fill[black] (0,0) circle (1.2pt);
\node[below right] at (0,0) {\(0\)};

\node[above right] at (1.3,1.35) {\(f_2\)};

\end{tikzpicture}