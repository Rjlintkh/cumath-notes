\begin{tikzpicture}[
    bluefill/.style={
        draw=blue!75!black,
        fill=blue!30,
        fill opacity=0.7,
        draw opacity=1,
        line width=1pt
    },
    redfill/.style={
        draw=red!75!black,
        fill=red!30,
        fill opacity=0.7,
        draw opacity=1,
        line width=1pt
    },
    greenfill/.style={
        draw=green!75!black,
        fill=green!30,
        fill opacity=0.7,
        draw opacity=1,
        line width=1pt
    },
    greenarrow/.style={
        ->,
        green!75!black,
        line width=0.5pt
    },
    manifold/.style={
        draw=red!75!black,
        fill=gray!10,
        line width=1pt
    },
    middlearea/.style={
        draw=red!75!black,
        fill=gray!10,
        line width=1pt
    },
  ]
    \def\R{1}
    
    
    % U
    \draw[redfill]
    plot[smooth cycle, tension=0.75] coordinates {
        (1.55,0.05)
        (1.28,0.92)
        (0.58,1.45)
        (-0.42,1.52)
        (-1.25,1.05)
        (-1.60,0.10)
        (-1.35,-0.88)
        (-0.52,-1.45)
        (0.45,-1.48)
        (1.22,-0.98)
    };
    \node[red!80!black] at (1.45,1.25) {\(U\)};

    % K
    \draw[bluefill]
        (0:\R)
        \foreach \angle in {60,120,180,240,300} {
            -- (\angle:\R)
        }
        -- cycle;
    \node[blue!80!black] at (-0.3,0.3) {\(K\)};

    % U_q
    \draw[greenfill]
    plot[smooth cycle, tension=0.40] coordinates {
        (1.10,-0.48)
        (0.92,-0.10)
        (0.50,0.02)
        (0.15,-0.12)
        (-0.02,-0.48)
        (0.10,-0.82)
        (0.42,-1.05)
        (0.82,-0.95)
        (1.08,-0.70)
    };

    \node[green!60!black] at (1.2,-1.12) {\(U_q\)};
    \fill (0.5,-0.5) circle (1.5pt) node[above left] {\(q\)};
    
    % phi_q
    \draw[greenarrow]
      (1.6,-0.5) -- (4,0)
      node[midway,above] {\(\varphi_q\)};
    
    \draw[greenfill]
        plot[smooth cycle, tension=0.55] coordinates {
        (7.55,0.10)
        (7.36,0.92)
        (6.88,1.42)
        (6.15,1.66)
        (5.35,1.47)
        (4.75,0.88)
        (4.54,0.05)
        (4.77,-0.78)
        (5.30,-1.35)
        (6.05,-1.58)
        (6.82,-1.43)
        (7.40,-0.82)
    };
    \node[green!60!black] at (7.65,-1.2) {\(V_q\)};
    
    \draw[redfill] (6,0) circle (1.15);
    \draw[middlearea] (6,0) circle (0.95);
    \draw[bluefill] (6,0) circle (0.8);
    
    \node[red!75!black] at (7.45,1) {\(B_a(0)\)};
    \node[blue!75!black] at (7.65,0.2) {\(B_{a-\eps}(0)\)};
    \fill (6,0) circle (1.5pt) node[above left] {\(0\)};

\end{tikzpicture}